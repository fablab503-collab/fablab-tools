<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Network is used by the Download map screen only (download.MapDownloadService). MapLibre is
        kept offline with MapLibre.setConnected(false) in VeloTrackApp; CI asserts that guard.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!--
        Recording a ride needs GPS, but reviewing rides, importing and browsing offline maps and
        exporting GPX do not. Requiring the hardware kept the app off every Chromebook, Wi-Fi-only
        tablet and headset in the Play catalogue. GpsSource already treats a missing provider as
        "no fix" rather than an error, and the status dot says so on screen.
    -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- Chromebooks and desktop-mode devices drive the app with a mouse or trackpad. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".VeloTrackApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VeloTrack">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.TracksActivity"
            android:exported="false"
            android:label="@string/title_tracks" />

        <activity
            android:name=".ui.StatsActivity"
            android:exported="false"
            android:label="@string/title_stats" />

        <activity
            android:name=".ui.MapFilesActivity"
            android:exported="false"
            android:label="@string/title_map_files" />

        <activity
            android:name=".ui.DownloadMapActivity"
            android:exported="false"
            android:label="@string/title_download_map"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.CountryPickerActivity"
            android:exported="false"
            android:label="@string/title_country_picker"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.PlacePickerActivity"
            android:configChanges="keyboardHidden"
            android:exported="false"
            android:label="@string/picker_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.CarbonActivity"
            android:exported="false"
            android:label="@string/carbon_title" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <service
            android:name=".recording.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Own process: MapLibre's bundled SQLite and the platform SQLite must not share one process while writing the same band files. -->
        <service
            android:name=".download.MapDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":download" />

        <!--
            Started by Play Services when a paired watch sends a button tap, so a ride can be begun
            from the wrist while the phone is asleep. exported="true" is required: the caller is
            Play Services, a different process. The Data Layer only delivers between apps that share
            an application ID and a signing certificate, so nothing else on the device can reach it.
        -->
        <service
            android:name=".wear.WearCommandService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/velotrack"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
