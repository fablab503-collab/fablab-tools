<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        DayNight: the -night qualifier picks the Material3 Dark parent and values-night/colors.xml;
        AppCompatDelegate.setDefaultNightMode (NightModeManager) decides which one applies. Material
        You dynamic colour is applied on top by DynamicColors.applyToActivitiesIfAvailable in
        VeloTrackApp; the colour roles below are the baseline for devices without dynamic colour.
        values/themes.xml and values-night/themes.xml are identical except android:windowLightStatusBar.
    -->
    <style name="Theme.VeloTrack" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Interstate everywhere: theme-level family for every TextView-based widget, plus the
             M3 type scale for drawable-rendered text (Chip, Badge, Slider tooltip). -->
        <item name="android:fontFamily">@font/interstate</item>
        <item name="fontFamily">@font/interstate</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.VeloTrack.ListItem</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.VeloTrack.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.VeloTrack.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.VeloTrack.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.VeloTrack.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.VeloTrack.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.VeloTrack.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.VeloTrack.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.VeloTrack.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.VeloTrack.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.VeloTrack.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.VeloTrack.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.VeloTrack.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.VeloTrack.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.VeloTrack.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.VeloTrack.LabelSmall</item>

        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>
</resources>
