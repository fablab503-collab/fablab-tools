<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material 3 type scale in Interstate. Each role keeps the M3 size and line height of its
        parent and only swaps the family (both fontFamily attributes: framework TextView reads
        android:fontFamily, Material's TextAppearance parser used by Chip/Badge/Slider reads either)
        and zeroes the letter spacing, which was tuned for Roboto and looks gappy on a condensed face.
    -->
    <style name="TextAppearance.VeloTrack.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/interstate</item>
        <item name="android:fontFamily">@font/interstate</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.VeloTrack.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/interstate</item>
        <item name="android:fontFamily">@font/interstate</item>
