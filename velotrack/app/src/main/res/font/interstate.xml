<?xml version="1.0" encoding="utf-8"?>
<!--
    Interstate Comp Regular, the single face used app-wide. minSdk 26: the android: namespace is
    enough (native fonts in XML). Bold requests are synthesised by the framework.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/interstate_comp"
        android:fontStyle="normal"
        android:fontWeight="400" />
</font-family>
