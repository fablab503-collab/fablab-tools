<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the "Set Home / Work" dialog: a short explanation and the name field. The two ways of
     picking the location (my position / map centre) are the dialog's buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/overlay_padding"
    android:paddingEnd="@dimen/overlay_padding">

    <TextView
        android:id="@+id/bodyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Where is Home? Use my position, or pan the map to the spot first and use the map centre." />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nameLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_margin"
        android:hint="@string/fav_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="1"
            tools:text="Home" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Type an address instead of hunting for it on the map. Submitting looks it up and fills the
         location in place, so the dialog can be finished without leaving it. -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/addressLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_margin"
        android:hint="@string/picker_search_hint"
        app:endIconContentDescription="@string/picker_search_hint"
        app:endIconDrawable="@drawable/ic_search"
        app:endIconMode="custom">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/addressInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="textPostalAddress"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- "Searching…", "no match", "couldn't search". Only ever one line of state; the matches
         themselves go in the group below it. -->
    <TextView
        android:id="@+id/addressStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="Searching..."
        tools:visibility="visible" />

    <!-- Every match the search returned, as radio buttons, because that is what choosing one of
         several is. A radio shows which is chosen without anyone having to guess, and choosing is
         separated from saving: nothing is written until the dialog's own button is pressed, so the
         name and the icon above can still be set afterwards. Rows are added by MainActivity. -->
    <RadioGroup
        android:id="@+id/addressResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_margin"
        android:text="@string/fav_emoji_label"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/emojiGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:chipSpacingHorizontal="4dp"
        app:selectionRequired="false"
        app:singleLine="false"
        app:singleSelection="true" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/emojiCustomLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/fav_emoji_custom_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/emojiCustomInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="8"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Opens PlacePickerActivity; the dialog closes and the point comes back through MainActivity. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChooseOnMap"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_margin"
        android:text="@string/fav_choose_on_map"
        app:icon="@drawable/ic_map" />
</LinearLayout>
