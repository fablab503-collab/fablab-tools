<?xml version="1.0" encoding="utf-8"?>
<!--
    Choose a place by dragging the map under a fixed crosshair. The MapView is created in code and
    inserted at index 0 of mapContainer, exactly as MainActivity does, so the picker draws with the
    same offline bands and theme as the main map.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mapContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The crosshair never moves: the map slides beneath it. -->
    <ImageView
        android:id="@+id/crosshair"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:alpha="0.9"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_crosshair"
        app:tint="?attr/colorPrimary" />

    <!-- Top: what is under the crosshair, and the label to save it under. -->
    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.VeloTrack.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding_horizontal">

                <TextView
                    android:id="@+id/hintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/picker_hint"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/placeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="6dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    app:drawableStartCompat="@drawable/ic_place_16"
                    app:drawableTint="?attr/colorOnSurface"
                    tools:text="Rue de Rivoli" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/fav_name_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        tools:text="Home" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Bottom: jump to my position, and save. -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="@dimen/screen_margin">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMyPosition"
            style="@style/Widget.VeloTrack.Fab.Surface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:contentDescription="@string/cd_recenter"
            app:fabCustomSize="@dimen/fab_standard_size"
            app:srcCompat="@drawable/ic_my_location" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnSave"
            style="@style/Widget.VeloTrack.Fab.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:text="@string/picker_save"
            app:icon="@drawable/ic_check" />
    </FrameLayout>
</FrameLayout>
