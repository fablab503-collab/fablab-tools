<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mapContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The MapView is created programmatically in MainActivity.onCreate and inserted at index 0. -->

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top: HUD card + GPS banner. MainActivity adds the status-bar inset to this panel's top padding. -->
        <LinearLayout
            android:id="@+id/topPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <!-- Tapping anywhere on this card folds it away; btnShowHud below brings it back. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hudPanel"
                style="@style/Widget.VeloTrack.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_hide_hud"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="@dimen/card_corner">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding_horizontal"
                    android:paddingTop="@dimen/card_padding_vertical"
                    android:paddingEnd="@dimen/card_padding_horizontal"
                    android:paddingBottom="@dimen/card_padding_vertical">

                    <!-- The CO2 comparison, above the speed on the left. Deliberately worded as a
                         fact about cars ("a car would have emitted") rather than a saving credited
                         to the rider: cycling avoids emissions, it does not remove them, and only a
                         ride that actually replaced a drive avoids anything at all. Tapping opens
                         the full working, with sources. -->
                    <LinearLayout
                        android:id="@+id/carbonChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="32dp"
                        android:orientation="horizontal"
                        android:paddingStart="2dp"
                        android:paddingEnd="6dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/carbonIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/carbon_chip_icon"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/carbonValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="12.4 kg vs car" />
                    </LinearLayout>

                    <!-- Row 1: speed + unit on the left, clock / battery / GPS on the right -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/speedText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/hud_speed_placeholder"
                                android:textAppearance="?attr/textAppearanceDisplayLarge"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/hud_speed_text_size"
                                tools:text="27.4" />

                            <TextView
                                android:id="@+id/speedUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:maxLines="1"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="km/h" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_marginStart="8dp"
                            android:gravity="end"
                            android:orientation="vertical">

                            <!-- Local weather, right next to the clock. Gone until a reading
                                 exists (MainActivity.maybeRefreshWeather); tapping it opens the
                                 official per-location forecast page this data comes from. -->
                            <LinearLayout
                                android:id="@+id/weatherChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:minHeight="32dp"
                                android:orientation="horizontal"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:visibility="gone"
                                tools:visibility="visible">

                                <TextView
                                    android:id="@+id/weatherIcon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:importantForAccessibility="no"
                                    android:textSize="18sp"
                                    tools:text="⛅" />

                                <TextView
                                    android:id="@+id/weatherTemp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:maxLines="1"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="16°C" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/clockText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="6:35 PM" />

                            <TextView
                                android:id="@+id/batteryText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="87%" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:id="@+id/gpsStatusDot"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/bg_status_dot"
                                    android:importantForAccessibility="no" />

                                <TextView
                                    android:id="@+id/gpsText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:text="@string/hud_gps_searching"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    tools:text="GPS 9/14 · ±5 m" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 2: recording status chip (icon and tint set from code) -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/statusText"
                        style="@style/Widget.Material3.Chip.Assist"
                        app:ensureMinTouchTargetSize="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:checkable="false"
                        android:clickable="false"
                        android:focusable="false"
                        android:visibility="gone"
                        app:chipIcon="@drawable/ic_recording_dot"
                        app:chipIconVisible="true"
                        tools:text="Recording"
                        tools:visibility="visible" />

                    <!-- Row 3: ride statistics -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:id="@+id/distanceText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/hud_no_value"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="42.3 km" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:text="@string/hud_distance"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:id="@+id/movingTimeText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/hud_no_value"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="1:23:45" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:text="@string/hud_moving_time"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:id="@+id/avgSpeedText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/hud_no_value"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="24.1 km/h" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:text="@string/hud_avg_speed"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/elevationText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/hud_no_value"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="320 m" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxLines="1"
                                android:text="@string/hud_elevation_gain"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 4: where am I (road / park / water / town under the puck). Driven by MainActivity. -->
                    <TextView
                        android:id="@+id/placeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="6dp"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_place_16"
                        app:drawableTint="?attr/colorOnSurfaceVariant"
                        tools:text="Amphitheatre Parkway"
                        tools:visibility="visible" />

                    <!-- Row 5: guidance to a favourite; tap the text or Stop to end it -->
                    <LinearLayout
                        android:id="@+id/guidanceRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/guidanceText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:drawablePadding="6dp"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface"
                            app:drawableStartCompat="@drawable/ic_near_me"
                            app:drawableTint="?attr/colorTertiary"
                            tools:text="→ Home · 3.2 km · ahead-left" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStopGuidance"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/btn_stop_guidance" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/routeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:visibility="gone"
                        tools:text="Route: 12.3 km left"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/errorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorError"
                        android:visibility="gone"
                        tools:text="Error: storage"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/gpsBanner"
                style="@style/Widget.VeloTrack.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fab_gap"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorErrorContainer"
                app:cardCornerRadius="@dimen/card_corner_small"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/card_padding_horizontal"
                    android:paddingTop="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="@dimen/list_icon_size"
                        android:layout_height="@dimen/list_icon_size"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_location_off"
                        app:tint="?attr/colorOnErrorContainer" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/gps_off_banner"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnErrorContainer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGpsSettings"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_location_settings"
                        android:textColor="?attr/colorOnErrorContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- No map yet. Sits under the statistics, full width and centred, so the button
                 column can never overlap it and it reads as part of the status stack. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/noMapOverlay"
                style="@style/Widget.VeloTrack.Card.Flat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fab_gap"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="@dimen/card_corner"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/screen_margin">

                    <ImageView
                        android:id="@+id/noMapImage"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/img3d_explorer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/no_map_title"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/no_map_body"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDownloadMap"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"
                            android:text="@string/no_map_action"
                            app:icon="@drawable/ic_download" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Shown only while the statistics card is folded away. MainActivity pads it for the status bar. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnShowHud"
            style="@style/Widget.VeloTrack.Fab.Surface"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:contentDescription="@string/cd_show_hud"
            android:visibility="gone"
            app:fabCustomSize="@dimen/fab_small_size"
            app:maxImageSize="24dp"
            app:srcCompat="@drawable/ic_expand_more"
            tools:visibility="visible" />

        <!-- Bottom: controls. MainActivity adds the navigation-bar inset to this panel's bottom padding. -->
        <FrameLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/fab_gap"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/screen_margin">

            <!-- Left column: one vertical stack of equal round buttons, aligned to the start edge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnHome"
                    style="@style/Widget.VeloTrack.Fab.Surface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/cd_home"
                    app:fabCustomSize="@dimen/fab_standard_size"
                    app:srcCompat="@drawable/ic_home" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnWork"
                    style="@style/Widget.VeloTrack.Fab.Surface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fab_gap"
                    android:contentDescription="@string/cd_work"
                    app:fabCustomSize="@dimen/fab_standard_size"
                    app:srcCompat="@drawable/ic_work" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnFavorites"
                    style="@style/Widget.VeloTrack.Fab.Surface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fab_gap"
                    android:contentDescription="@string/cd_favorites"
                    app:fabCustomSize="@dimen/fab_standard_size"
                    app:srcCompat="@drawable/ic_star" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnRecenter"
                    style="@style/Widget.VeloTrack.Fab.Surface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fab_gap"
                    android:contentDescription="@string/cd_recenter"
                    app:fabCustomSize="@dimen/fab_standard_size"
                    app:srcCompat="@drawable/ic_my_location" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnToggle3d"
                    style="@style/Widget.VeloTrack.Fab.Surface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fab_gap"
                    android:contentDescription="@string/cd_toggle_view"
                    app:fabCustomSize="@dimen/fab_standard_size"
                    app:srcCompat="@drawable/ic_3d_rotation" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnMenu"
                    style="@style/Widget.VeloTrack.Fab.Surface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fab_gap"
                    android:contentDescription="@string/cd_menu"
                    app:fabCustomSize="@dimen/fab_standard_size"
                    app:srcCompat="@drawable/ic_more_vert" />
            </LinearLayout>

            <!-- Bottom-right: primary action. Visibility is driven by MainActivity.render. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/btnRecord"
                    style="@style/Widget.VeloTrack.Fab.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_record"
                    app:icon="@drawable/ic_record" />

                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/btnPause"
                    style="@style/Widget.VeloTrack.Fab.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_pause"
                    android:visibility="gone"
                    app:icon="@drawable/ic_pause"
                    tools:visibility="visible" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnStop"
                    style="@style/Widget.VeloTrack.Fab.Plain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fab_gap"
                    android:contentDescription="@string/cd_stop"
                    android:visibility="gone"
                    app:backgroundTint="?attr/colorErrorContainer"
                    app:fabCustomSize="@dimen/fab_standard_size"
                    app:srcCompat="@drawable/ic_stop"
                    app:tint="?attr/colorOnErrorContainer"
                    tools:visibility="visible" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
