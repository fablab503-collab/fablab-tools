 "options_how_links": {
  "description": "options.json",
  "message": "<strong>Clean links.</strong> Tracking tags such as utm_source or fbclid are removed from a page's address before it loads."
 },
 "options_how_network": {
  "description": "options.json",
  "message": "<strong>Network blocking.</strong> Filter lists are compiled into Safari's <em>declarativeNetRequest</em> rules. Safari applies them itself, so Bouclier never sees the pages you visit."
 },
 "options_how_popups": {
  "description": "options.json",
  "message": "<strong>Pop-ups.</strong> When a page opens a new tab to an address on the lists' pop-up filters, Bouclier closes it and tells you."
 },
 "options_how_stats": {
